# Cấu hình môi trường THẬT cho docker-compose.prod.yml. Sao chép thành .env.prod rồi điền; KHÔNG đưa .env.prod lên git.

# --- Cơ sở dữ liệu ---
# Dùng mật khẩu ngẫu nhiên chỉ gồm chữ và số để không phải mã hóa URL, ví dụ: openssl rand -hex 24
POSTGRES_USER=kgs
POSTGRES_PASSWORD=
POSTGRES_DB=kgs_booking

# --- Ứng dụng ---
# Khóa ký phiên đăng nhập: BẮT BUỘC đổi, ví dụ: openssl rand -base64 32
AUTH_SECRET=
# Địa chỉ công khai của website (HTTPS). Dùng cho liên kết trong email, sitemap và địa chỉ VNPay gọi về.
APP_URL=https://stay.example.com

# --- Thanh toán VNPay (để trống cả hai để dùng cổng giả lập, CHỈ dành cho thử nghiệm) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Khi chạy thật đổi sang địa chỉ production do VNPay cấp; để trống là dùng sandbox.
VNPAY_URL=

# --- Email xác nhận (để trống SMTP_HOST thì không gửi email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Không Gian Số Stay <no-reply@stay.example.com>"
