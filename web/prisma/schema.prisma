generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  // Đối tác: chủ khách sạn trên sàn, chỉ quản lý khách sạn và đơn của mình.
  HOST
}

enum HotelApproval {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentProvider {
  SIMULATED
  VNPAY
}

enum PaymentTxnStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  phone         String?
  passwordHash  String
  role          Role                 @default(USER)
  createdAt     DateTime             @default(now())
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  resetTokens   PasswordResetToken[]
  hotels        Hotel[]              @relation("HotelOwner")
  payouts       Payout[]             @relation("PayoutOwner")
  notifications Notification[]
}

model Hotel {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  name                 String
  description          String
  address              String
  city                 String
  country              String        @default("Việt Nam")
  latitude             Float?
  longitude            Float?
  starRating           Int           @default(3)
  images               String[]
  amenities            String[]
  // Điểm nổi bật về vị trí/cảnh quan, ví dụ "Gần Hồ Xuân Hương". Dùng để lọc và để trợ lý ảo hiểu yêu cầu của khách.
  highlights           String[]      @default([])
  isActive             Boolean       @default(true)
  // Sàn trung gian: khách sạn của đối tác có chủ (ownerId) và được quản trị viên duyệt trước khi hiển thị; ownerId rỗng là khách sạn do sàn tự vận hành.
  ownerId              String?
  owner                User?         @relation("HotelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approval             HotelApproval @default(APPROVED)
  approvalNote         String?
  commissionPercent    Int           @default(10)
  // Chính sách hủy: hủy trước ngày nhận phòng ít nhất freeCancelDays ngày thì hoàn đủ, muộn hơn bị trừ lateCancelFeePercent% tiền đã trả.
  freeCancelDays       Int           @default(1)
  lateCancelFeePercent Int           @default(50)
  createdAt            DateTime      @default(now())
  rooms                Room[]
  reviews              Review[]
  favorites            Favorite[]

  @@index([city])
}

model Room {
  id             String      @id @default(cuid())
  hotelId        String
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String
  description    String
  pricePerNight  Int
  // Phụ thu (+) hoặc giảm (-) theo phần trăm cho đêm thứ Sáu và thứ Bảy.
  weekendPercent Int         @default(0)
  // Ảnh toàn cảnh 360° (tỷ lệ 2:1) để khách xem phòng trực tiếp; để trống nếu chưa có.
  panoramaUrl    String?
  capacity       Int         @default(2)
  bedType        String
  sizeM2         Int?
  images         String[]
  amenities      String[]
  // Điểm nổi bật của phòng, ví dụ "View hồ Xuân Hương", "Ban công".
  highlights     String[]    @default([])
  quantity       Int         @default(1)
  isActive       Boolean     @default(true)
  bookings       Booking[]
  blocks         RoomBlock[]
  priceRules     PriceRule[]

  @@index([hotelId])
}

model Booking {
  id                String        @id @default(cuid())
  code              String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  roomId            String
  room              Room          @relation(fields: [roomId], references: [id])
  checkIn           DateTime
  checkOut          DateTime
  guests            Int
  rooms             Int           @default(1)
  totalPrice        Int
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  note              String?
  voucherCode       String?
  discount          Int           @default(0)
  refundAmount      Int?
  cancelledAt       DateTime?
  commissionPercent Int           @default(0)
  payoutId          String?
  payout            Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  createdAt         DateTime      @default(now())
  payments          Payment[]

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([createdAt])
  @@index([status, paymentStatus])
}

model Review {
  id        String    @id @default(cuid())
  hotelId   String
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  isHidden  Boolean   @default(false)
  // Phản hồi của khách sạn (đối tác hoặc quản trị viên) dưới đánh giá của khách.
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([hotelId, userId])
  @@index([hotelId, isHidden])
  @@index([isHidden, createdAt])
}

model Favorite {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

// Mỗi lần thanh toán là một dòng riêng (txnRef duy nhất) để đối soát và xử lý kết quả cổng thanh toán đúng một lần.
model Payment {
  id            String           @id @default(cuid())
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  txnRef        String           @unique
  amount        Int
  status        PaymentTxnStatus @default(PENDING)
  method        String?
  providerTxnNo String?
  responseCode  String?
  note          String?
  createdAt     DateTime         @default(now())
  paidAt        DateTime?
  refundedAt    DateTime?
  refundNote    String?

  @@index([bookingId])
}

// Bộ đếm cho giới hạn số lần thử (đăng nhập sai...): mỗi khóa có một cửa sổ thời gian cố định.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model Voucher {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String    @default("")
  percentOff   Int?
  amountOff    Int?
  maxDiscount  Int?
  minSubtotal  Int       @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  perUserLimit Int       @default(1)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  rooms     Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([roomId, startDate, endDate])
}

/// Đợt chi trả cho đối tác: gộp các đơn đã đối soát; tiền chi = tổng thu - hoa hồng của sàn.
model Payout {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation("PayoutOwner", fields: [ownerId], references: [id])
  gross        Int
  commission   Int
  amount       Int
  bookingCount Int
  note         String?
  createdById  String
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@index([ownerId, createdAt])
}

/// Giá theo mùa/ngày lễ: cộng thêm (+) hoặc giảm (-) phần trăm so với giá gốc cho các đêm trong [startDate, endDate).
model PriceRule {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  percent   Int
  createdAt DateTime @default(now())

  @@index([roomId, startDate, endDate])
}

/// Thông báo trong ứng dụng cho đối tác và quản trị viên (đơn mới, đơn bị hủy, khách sạn chờ duyệt...).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Nhật ký thao tác nhạy cảm (tiền, duyệt khách sạn, đổi quyền...) để truy vết ai đã làm gì. Chỉ ghi thêm, không sửa/xóa.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  actorRole  String
  action     String
  targetType String?
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}
