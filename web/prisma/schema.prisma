generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentProvider {
  SIMULATED
  VNPAY
}

enum PaymentTxnStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]
}

model Hotel {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  address     String
  city        String
  country     String     @default("Việt Nam")
  latitude    Float?
  longitude   Float?
  starRating  Int        @default(3)
  images      String[]
  amenities   String[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  rooms       Room[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([city])
}

model Room {
  id            String    @id @default(cuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String
  description   String
  pricePerNight Int
  capacity      Int       @default(2)
  bedType       String
  sizeM2        Int?
  images        String[]
  amenities     String[]
  quantity      Int       @default(1)
  isActive      Boolean   @default(true)
  bookings      Booking[]

  @@index([hotelId])
}

model Booking {
  id            String        @id @default(cuid())
  code          String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int           @default(1)
  totalPrice    Int
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  note          String?
  createdAt     DateTime      @default(now())
  payments      Payment[]

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([createdAt])
  @@index([status, paymentStatus])
}

model Review {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([hotelId, userId])
  @@index([hotelId, isHidden])
  @@index([isHidden, createdAt])
}

model Favorite {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

// Mỗi lần thanh toán là một dòng riêng (txnRef duy nhất) để đối soát và xử lý kết quả cổng thanh toán đúng một lần.
model Payment {
  id            String           @id @default(cuid())
  bookingId     String
  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  txnRef        String           @unique
  amount        Int
  status        PaymentTxnStatus @default(PENDING)
  method        String?
  providerTxnNo String?
  responseCode  String?
  note          String?
  createdAt     DateTime         @default(now())
  paidAt        DateTime?
  refundedAt    DateTime?
  refundNote    String?

  @@index([bookingId])
}

// Bộ đếm cho giới hạn số lần thử (đăng nhập sai...): mỗi khóa có một cửa sổ thời gian cố định.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}
