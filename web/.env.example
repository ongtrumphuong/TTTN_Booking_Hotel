# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# Chuỗi kết nối PostgreSQL. Mật khẩu có ký tự đặc biệt phải mã hóa URL (ví dụ @ thành %40).
DATABASE_URL="postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/kgs_booking?schema=public"

# Khóa ký phiên đăng nhập. Tạo khóa mạnh: npx auth secret
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien-dai"

# Chạy production trên máy cục bộ
AUTH_TRUST_HOST=true

# URL gốc của website (dùng cho liên kết trong email và địa chỉ VNPay gọi về).
# Triển khai thật: đặt đúng tên miền HTTPS, ví dụ https://stay.khongiansos.vn
APP_URL="http://localhost:3000"

# --- Thanh toán VNPay (sandbox) ---
# Để TRỐNG cả hai biến để dùng cổng thanh toán giả lập. Khi điền đủ cả hai, hệ thống chuyển sang VNPay và TẮT cổng giả lập.
# Đăng ký tài khoản thử nghiệm miễn phí tại https://sandbox.vnpayment.vn/devreg/ rồi lấy mã website (TmnCode) và khóa bí mật.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
# Mặc định là địa chỉ sandbox; khi chạy thật đổi sang địa chỉ production do VNPay cấp.
# VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# --- Email xác nhận đặt phòng (SMTP) ---
# Để trống SMTP_HOST thì không gửi email (đặt phòng vẫn hoạt động bình thường).
# Ví dụ Gmail: host smtp.gmail.com, cổng 587, mật khẩu là "Mật khẩu ứng dụng" (bật xác minh 2 bước trước).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Không Gian Số Stay <no-reply@khongiansos.vn>"
